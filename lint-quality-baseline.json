{
  "schemaVersie": 1,
  "scope": [
    "app",
    "core",
    "platform",
    "fondsen"
  ],
  "uitleg": "Bestaande React/Hooks/Next-bevindingen. De gate blokkeert alleen toenames per bestand en regel.",
  "totaal": 27,
  "perRegel": {
    "react-hooks/error-boundaries": 2,
    "react-hooks/exhaustive-deps": 1,
    "react-hooks/immutability": 3,
    "react-hooks/set-state-in-effect": 15,
    "react-hooks/static-components": 5,
    "react/no-unescaped-entities": 1
  },
  "bestanden": {
    "app/(dashboard)/ai/_components/AntwoordWeergave.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "app/(dashboard)/ai/_components/AssistentClient.tsx": {
      "react-hooks/exhaustive-deps": 1
    },
    "app/(dashboard)/beheer/_components/BeheerClient.tsx": {
      "react-hooks/set-state-in-effect": 3
    },
    "app/(dashboard)/beheer/_components/ConfigBeheer.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "app/(dashboard)/beheer/stuurinformatie/_components/StuurinfoInvoer.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "app/(dashboard)/bibliotheek/_components/ZoekenPaneel.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "app/(dashboard)/bibliotheek/page.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "app/(dashboard)/procedures/_components/AfschriftenPaneel.tsx": {
      "react-hooks/immutability": 1
    },
    "app/(dashboard)/procedures/_components/StapPaneel.tsx": {
      "react-hooks/set-state-in-effect": 3
    },
    "app/(dashboard)/vergaderingen/_components/VoorbereidingsBlok.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "app/(platform)/platform/(beveiligd)/ai-begrenzing/page.tsx": {
      "react-hooks/error-boundaries": 2
    },
    "app/(platform)/platform/(beveiligd)/aqlab/run-samenstellen-form.tsx": {
      "react/no-unescaped-entities": 1
    },
    "app/(platform)/platform/login/page.tsx": {
      "react-hooks/immutability": 1,
      "react-hooks/set-state-in-effect": 1
    },
    "app/(public)/contact/_components/ContactForm.tsx": {
      "react-hooks/static-components": 5
    },
    "core/components/DashboardShell.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "core/components/DocumentMetadataModal.tsx": {
      "react-hooks/set-state-in-effect": 1
    },
    "core/components/Sidebar.tsx": {
      "react-hooks/immutability": 1
    }
  }
}
