+export function veiligVervolgpad(ruw: string | null | undefined): string {
+  if (!ruw) return "/";
+  if (/[\r\n]/.test(ruw)) return "/";
+  if (!ruw.startsWith("/")) return "/";
+  if (ruw.startsWith("//") || ruw.startsWith("/\\")) return "/";
+  return ruw;
+}
