{
  "name": "bestuurdersportaal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run lint:colors",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:colors": "node scripts/check-brand-hex.mjs",
    "lint:boundaries": "eslint core platform fondsen --no-error-on-unmatched-pattern",
    "sanity": "for f in lib/*.sanity.ts; do echo \"› $f\"; ./node_modules/.bin/tsx \"$f\" || exit 1; done",
    "aqlab:seed": "tsx lib/aqlab/seed/cli.ts",
    "aqlab:seed:apply": "tsx lib/aqlab/seed/cli.ts --apply",
    "test:xtenant": "node --import tsx --test tests/cross-tenant/*.test.ts",
    "test:xtenant:ci": "bash scripts/cross-tenant-ci.sh",
    "prepare": "git config core.hooksPath scripts/hooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@vercel/analytics": "^1.6.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^0.12.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.63.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "js-yaml": "^4.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
